SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Production (Render sets RENDER_EXTERNAL_HOSTNAME automatically):
# ALLOWED_HOSTS=hilaac-academy.onrender.com
# CSRF_TRUSTED_ORIGINS=https://hilaac-academy.onrender.com
# SITE_URL=https://hilaac-academy.onrender.com
# DEBUG=False

# Database — production uses SQLite on a Render persistent disk (no PostgreSQL).
# Attach a disk at /app/data in the Render dashboard (Starter plan or above).
USE_SQLITE=True
PERSISTENT_DATA_DIR=/app/data
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@hilaacacademy.com
# ADMIN_PASSWORD=choose-a-strong-password

# Optional PostgreSQL (only if USE_SQLITE=False)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hilaac_academy
DB_USER=hilaac
DB_PASSWORD=hilaac_secret
DB_HOST=localhost
DB_PORT=5432

# Gunicorn — use 1 worker with SQLite to avoid database locking
GUNICORN_WORKERS=1

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Set False in production when Redis + Celery worker are running
CELERY_TASK_ALWAYS_EAGER=True

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hilaacacademy.com

