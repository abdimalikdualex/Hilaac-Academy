# Hilaac Academy — production environment for Hostinger VPS (Ubuntu 24.04).
# Copy to .env on the server and fill in real values. NEVER commit the real .env.

# --- Core ---
SECRET_KEY=generate-a-long-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=abdimalikduale.com,www.abdimalikduale.com
CSRF_TRUSTED_ORIGINS=https://abdimalikduale.com,https://www.abdimalikduale.com
SITE_URL=https://abdimalikduale.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://hilaac:STRONG_DB_PASSWORD@localhost:5432/hilaac_academy

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Media & logs (persist outside the git repo) ---
MEDIA_ROOT=/home/hilaac/media
LOGS_DIR=/home/hilaac/logs
# Serve sensitive media through Nginx X-Accel-Redirect after auth checks
USE_X_ACCEL_REDIRECT=True

# --- Gunicorn ---
GUNICORN_WORKERS=3

# --- Security (defaults are already strict when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=1209600

# --- Super admin (auto-created/reset on deploy via ensure_admin) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hilaacacademy.com
ADMIN_PASSWORD=set-a-strong-password

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hilaacacademy.com
REQUIRE_EMAIL_VERIFICATION=True

# --- Optional: Cloudinary for media (leave blank to use the VPS disk) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (fill when integrating) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=production
EVC_PLUS_MERCHANT_ID=
EVC_PLUS_API_KEY=

# --- Support ---
WHATSAPP_SUPPORT_NUMBER=+254722156718
